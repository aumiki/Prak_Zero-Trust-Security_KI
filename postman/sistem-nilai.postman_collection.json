{
  "info": {
    "name": "Sistem Nilai - Zero Trust",
    "description": "Alur demo Tugas Praktikum Zero Trust. Jalankan server (npm start) dan reset data (npm run seed) sebelum memulai. Jalankan folder berurutan 1 -> 8. Folder 4 membutuhkan config/access-hours.json diubah dulu (lihat deskripsi folder). Nama request memuat status yang diharapkan; tab Test Results hijau berarti sesuai.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "nilai_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "transkrip_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "service_secret",
      "value": "service-nilai-secret"
    },
    {
      "key": "gateway_secret",
      "value": "dev-gateway-secret-ganti-di-produksi"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi",
      "item": [
        {
          "name": "1.1 Login dosen1 (device benar) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set(\"token_dosen1\", j.access_token);",
                  "  pm.collectionVariables.set(\"refresh_dosen1\", j.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-ID",
                "value": "DEV-DOSEN1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dosen1\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
